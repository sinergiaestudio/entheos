# Sites injects authenticated identity, DB and BUCKET bindings at runtime.
# Do not place clinical data, personal tokens, passwords or document URLs here.

# Intervals.icu OAuth application. Configure these only in the hosted runtime.
APP_OWNER_EMAIL=
# ANATHEOS is disabled unless explicitly enabled in a verified isolated runtime.
# Never enable in production or a public/untrusted preview.
ANATHEOS_PILOT_ENABLED=false
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
ENTHEOS_INTEGRATION_KEY=
